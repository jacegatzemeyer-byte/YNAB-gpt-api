# Required YNAB / middleware secrets
YNAB_API_TOKEN=
YNAB_BUDGET_ID=
MIDDLEWARE_API_KEY=
REF_SECRET=

# Public service configuration
PUBLIC_BASE_URL=https://your-service.up.railway.app
HOUSEHOLD_TIMEZONE=America/Chicago
PRIMARY_CHECKING_NAME=WF Checking
CHECKING_FLOOR=1000.00
HISTORY_DAYS=365
CACHE_TTL_SECONDS=45
PROPOSAL_TTL_SECONDS=900

# Plaid application credentials
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_DAYS_REQUESTED=365
PLAID_HOUSEHOLD_ID=household

# Recommended: Railway PostgreSQL service reference.
# Railway normally injects DATABASE_URL automatically after you link Postgres.
DATABASE_URL=

# Legacy / migration-only fallbacks. Do not commit real values.
PLAID_ACCESS_TOKEN=
PLAID_ITEM_ID=
PLAID_ITEMS_JSON=[]
PLAID_YNAB_ACCOUNT_MAP={}
